# Normalise line endings: LF in the repository, native on checkout is disabled so
# every platform sees the same bytes the editorconfig asks for.
* text=auto eol=lf

# Windows-only files keep CRLF
*.sln text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.ico binary
*.dll binary
*.zip binary
